# Configuration de l'envoi hors site des sauvegardes.
#
# ⚠️ CE FICHIER EST UN DOCUMENT, PAS UNE SOURCE (règle 36). Aucun processus ne
# le lit. Le vrai fichier vit à ~/.echango-backup.env, EN DEHORS du dépôt, et
# doit être en 600 — `backup-db.sh` refuse de lire une phrase de passe que tout
# le monde peut lire.
#
#     cp scripts/backup.env.example ~/.echango-backup.env
#     chmod 600 ~/.echango-backup.env
#     # puis remplir les quatre valeurs vides ci-dessous
#
# ── Pourquoi PAS dans apps/backend/.env ─────────────────────────────────────
#
# La phrase de passe des sauvegardes n'a aucune raison d'entrer dans
# l'environnement du processus NestJS. Un fichier séparé garde la surface
# minimale : ce que le backend ne connaît pas ne peut pas fuiter avec lui.

# ── Le dépôt de destination ─────────────────────────────────────────────────
#
# ⚠️ `echango-private` et NON `echango-promo`. Mesuré le 2026-08-05, en
# anonyme, sans aucune authentification :
#
#     echango-private   listage 403 · objet inexistant 403 · rien ne sort
#     echango-promo     listage 403 · une photo de promo : 200, 92 Ko
#
# `echango-promo` est le dépôt de l'application : `storage.service.ts:192` y
# pose `ACL: public-read` sur tout ce qui n'est pas `registre-documents/`. Il
# sert des objets publics par conception. Une sauvegarde complète de la base
# n'y tiendrait que par la justesse d'un seul argument d'ACL.
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_BUCKET=echango-private
BACKUP_S3_PREFIX=db-backups/

# ── Les identifiants ────────────────────────────────────────────────────────
#
# ⚠️ Délibérément SÉPARÉS de S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY. Les
# identifiants de l'application ont besoin d'écrire des photos ; ceux-ci ont
# besoin d'écrire des sauvegardes. Les confondre donne à quiconque compromet
# l'application le pouvoir d'effacer les sauvegardes — c'est-à-dire de
# transformer un incident récupérable en perte définitive.
#
# Aucun repli automatique vers S3_* n'existe : si l'on choisit malgré tout de
# réutiliser la même clé, on la recopie ici explicitement, et ce choix reste
# visible.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── Le chiffrement ──────────────────────────────────────────────────────────
#
# Le dump contient TOUT : numéros de téléphone, empreintes de mots de passe,
# registres de commerce. Il est chiffré (AES-256, gpg symétrique) avant de
# quitter la machine, et le script vérifie qu'il se DÉCHIFFRE avant de
# l'envoyer — un fichier chiffré qu'on n'a jamais rouvert n'est pas une
# sauvegarde, exactement comme un dump qu'on n'a jamais restauré.
#
# ⚠️ PERDRE CETTE PHRASE REND TOUTES LES SAUVEGARDES DÉFINITIVEMENT
# ILLISIBLES. Elle se range où se range un secret — gestionnaire de mots de
# passe, coffre — et surtout PAS uniquement sur la machine qu'elle est censée
# protéger de la perte.
BACKUP_PASSPHRASE=

# Combien de sauvegardes garder dans le dépôt distant (locale : GARDER, 7 par
# défaut). Plus long à distance qu'en local : c'est la copie qui survit à la
# machine, donc celle qui doit remonter le plus loin.
BACKUP_GARDER_DISTANT=30

# ── Les deux désactivations, qui doivent être ÉCRITES ───────────────────────
#
# Sans elles, une configuration absente est un échec — parce qu'on ne peut pas
# distinguer « choisi » de « oublié » (règle 29). Les poser, c'est assumer par
# écrit ; le script le dit alors à chaque passage au lieu d'échouer.
#
# BACKUP_REMOTE=off        sauvegarde locale seule — ne protège PAS d'une
#                          perte de disque
# BACKUP_CHIFFREMENT=off   le dump part EN CLAIR chez le fournisseur
