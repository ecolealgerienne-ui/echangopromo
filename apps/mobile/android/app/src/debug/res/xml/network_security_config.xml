<?xml version="1.0" encoding="utf-8"?>
<!--
  Autorise le HTTP EN CLAIR vers la machine de développement, et vers elle
  seule.

  ── Pourquoi ce fichier existe ────────────────────────────────────────────

  Android bloque le trafic en clair par défaut depuis l'API 28, et ce projet
  cible l'API 36. Un build pointé sur `http://10.0.2.2:3000` (le backend local,
  vu depuis l'émulateur) échouait donc à chaque requête — sans que la cause
  soit lisible côté app : Dio rend une erreur réseau ordinaire, exactement
  celle d'un serveur éteint. On cherche le backend, alors que c'est le
  système qui refuse (constaté le 2026-08-05).

  ── Pourquoi cette forme, et pas `usesCleartextTraffic="true"` ────────────

  L'attribut global autoriserait le clair vers N'IMPORTE QUEL hôte. Ici seuls
  trois domaines sont ouverts, et `cleartextTrafficPermitted` reste `false`
  partout ailleurs — un appel HTTP accidentel vers un autre serveur échoue
  toujours, ce qui est le comportement voulu.

  ⚠️ Ce fichier vit dans `src/debug/`, donc il n'entre QUE dans les builds de
  debug. Il n'est pas fusionné dans un build de release : la production ne
  parle qu'en HTTPS, et rien ici ne peut l'assouplir. C'est la raison du
  placement — le mettre dans `src/main/` aurait suivi jusqu'au Play Store.
-->
<network-security-config>
    <!--
      ⚠️ N'essayez PAS d'ajouter ici `<trust-anchors><certificates src="user"/>`
      pour faire passer l'app derrière un antivirus ou un proxy qui inspecte le
      HTTPS : **ce fichier ne gouverne pas les requêtes de l'app.** Il gouverne
      la pile réseau Java/Android ; Dio passe par `HttpClient` de `dart:io`, qui
      a son PROPRE magasin de racines (BoringSSL, alimenté par les seules
      racines système) et ignore aussi bien les autorités installées par
      l'utilisateur que ce fichier.

      Mesuré le 2026-08-05 contre le VPS, sur le même émulateur, à la même URL :
      racine de l'intercepteur installée en autorité utilisateur → **Chrome
      charge `https://promo.echango.com/promo/config`**, l'app rend toujours
      « Impossible de contacter le serveur ». Le remède est côté machine
      (exclure le domaine de l'inspection HTTPS), pas ici.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- L'hôte, vu depuis l'émulateur Android (jamais `localhost`, qui
             désigne le téléphone lui-même). -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Utile pour un backend joint via `adb reverse tcp:3000 tcp:3000`. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
