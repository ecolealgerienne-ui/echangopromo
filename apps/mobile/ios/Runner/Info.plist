<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Echango Promo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Echango Promo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Utilisée pour enregistrer la position de votre commerce, afin que les clients puissent le trouver facilement.</string>
	<key>NSCameraUsageDescription</key>
	<string>Utilisée pour prendre la photo de votre commerce ou d'une promo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Utilisée pour choisir une photo existante de votre commerce depuis votre galerie.</string>
	<!-- Conformité export (chiffrement). Sans cette clé, chaque build arrive
	     dans TestFlight avec la mention « Missing Compliance » et n'est PAS
	     distribuable : les testeurs reçoivent bien l'invitation, mais aucune
	     build n'apparaît dans l'app TestFlight, sans le moindre message
	     d'erreur (trouvé au premier envoi TestFlight, 2026-07-31). La
	     déclarer ici évite d'avoir à répondre au questionnaire à la main
	     pour chaque build.

	     `false` est la bonne valeur ici : l'app n'utilise que HTTPS/TLS via
	     les API standard du système, ce qui relève de l'exemption prévue par
	     l'Export Administration Regulations. À repasser à `true` (avec
	     dépôt d'un CCATS) uniquement si un jour on embarque notre propre
	     implémentation de chiffrement — ce qui n'est pas le cas. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
