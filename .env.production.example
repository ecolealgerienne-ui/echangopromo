# Modèle unique pour /opt/echangopromo/.env.production sur le VPS.
# Ne jamais commiter le fichier réel (gitignoré). Un seul fichier, utilisé
# de deux façons par docker-compose.promo.yml :
#   - comme --env-file (docker compose --env-file .env.production -f
#     docker-compose.promo.yml ...) pour la substitution ${...} dans le
#     fichier compose lui-même (POSTGRES_PASSWORD, BASE_DOMAIN) ;
#   - comme env_file: du service `backend`, donc injecté tel quel dans le
#     process NestJS (DATABASE_URL, JWT_SECRET, etc.).
# Les deux usages partagent POSTGRES_PASSWORD, ce qui élimine le risque de
# désync entre deux copies du même mot de passe (source d'un vrai incident
# de déploiement — voir docs/status_v0.md, entrée 2026-07-05).
#
# Voir docs/DEPLOIEMENT_VPS.md pour la procédure complète (migrations,
# seeds admin/commune).

# --- Lu par docker-compose.promo.yml (substitution ${...}) ---

# Mot de passe PostgreSQL du conteneur postgres de cette stack (interne,
# jamais exposé sur l'hôte). Choisir uniquement lettres/chiffres (éviter
# : / ? # [ ] @ ! $ & ' ( ) * + , ; = qui ont un sens spécial dans une URL
# et casseraient DATABASE_URL ci-dessous) — génération recommandée :
#   openssl rand -hex 24
# Pas de guillemets autour de la valeur (docker compose ne les retire pas).
POSTGRES_PASSWORD=change-me-alphanumeric-only

# Domaine racine, utilisé pour construire promo.${BASE_DOMAIN}. Déjà
# `echango.com` en prod (variable partagée avec la stack Traefik/Vendure).
BASE_DOMAIN=echango.com

# --- Lu par le process NestJS (env de app/backend) ---

NODE_ENV=production
PORT=3000

# CORS — pas de frontend web en V0, laisser vide tant qu'aucun n'est ajouté.
CORS_ORIGINS=

# PostgreSQL — hôte `postgres_promo` = nom du service dans
# docker-compose.promo.yml (réseau Docker interne, pas de port publié sur
# l'hôte). Volontairement PAS `postgres` tout court : la stack Vendure a son
# propre service `postgres` sur le même réseau externe `echango_network`, et
# le backend (attaché aux deux réseaux) résolvait silencieusement le nom
# générique vers LEUR conteneur au lieu du nôtre — incident réel de
# déploiement, voir docs/status_v0.md.
# Référence ${POSTGRES_PASSWORD} défini plus haut dans ce même fichier
# plutôt que de recopier la valeur — Compose interpole les `.env` en
# autorisant qu'une variable en référence une autre déjà définie plus haut
# dans le même fichier, donc un seul endroit à éditer, plus aucun risque de
# désync. Vérifier après coup que la substitution a bien eu lieu (pas de
# littéral "${POSTGRES_PASSWORD}" dans la valeur reçue par le conteneur) :
#   docker compose --env-file .env.production -f docker-compose.promo.yml \
#     run --rm backend node -e "console.log(process.env.DATABASE_URL)"
DATABASE_URL=postgres://echango:${POSTGRES_PASSWORD}@postgres_promo:5432/echango_promo

# JWT — secret long et aléatoire, différent de tout secret de dev
# (ex: openssl rand -base64 48).
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Bootstrap admin — laisser vide ici (ce fichier tourne en continu sur le
# VPS). Fournir email/mot de passe/nom en arguments CLI au moment du seed
# plutôt que de les stocker en clair dans ce fichier :
#   docker compose --env-file .env.production -f docker-compose.promo.yml \
#     exec backend npm run seed:admin:prod -- admin@echango.com "mot-de-passe" "Nom"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=

# S3 OVH (prod réelle, pas MinIO)
#
# ⚠️ DEUX VARIABLES, DEUX RÔLES : `S3_ENDPOINT` est ce que le SERVEUR appelle,
# `S3_CDN_BASE_URL` est ce que le CLIENT reçoit. Les confondre a coûté 300 s
# par création de promo en local (P9, 2026-08-04). Ici les valeurs sont
# correctes ; le rappel est là pour qu'on ne « simplifie » pas en les fusionnant.
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=echango-promo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CDN_BASE_URL=

# OVH rejette les URLs publiques en style "path" (endpoint/bucket/clé) —
# seul le style "virtual-hosted" (bucket.endpoint/clé) fonctionne pour
# l'affichage des photos (découvert au premier test réel). À true
# uniquement ici (prod OVH) — laisser false/absent en dev local (MinIO).
S3_PUBLIC_URL_VIRTUAL_HOSTED=true

# Rétention images (jours) — §5.8 des specs
IMAGE_RETENTION_DAYS=30

# Durée de validité d'une promo (jours) — §3.2 des specs
PROMO_DEFAULT_DURATION_DAYS=5
PROMO_MAX_DURATION_DAYS=7

# Promos simultanément en ligne par commerçant — §3.2 des specs.
# Servi à l'app par GET /promo/me/slots : le changer ici suffit, aucune
# recompilation mobile. Une valeur illisible retombe sur 5 (journalisée).
PROMO_ACTIVE_CAP=5

# Anti-abus publication (retour terrain 2026-07-14) — lues par PromoService
# depuis leur création, et absentes de ce fichier jusqu'au 2026-08-12 : deux
# réglages annoncés nulle part (règle #36).
PROMO_DAILY_CREATION_CAP=5
PROMO_REPUBLISH_COOLDOWN_HOURS=24

# ── Repères géographiques servis à l'app par GET /promo/config ──────────────
# Le mobile n'a pas de .env : ces valeurs ne sont PAS compilées dans le
# binaire, elles sont servies. Les changer ici suffit — aucune republication
# sur les stores, contrairement à un --dart-define.
#
# ⚠️ Le pilote est à Djelfa, le défaut ci-dessous est Alger. Pendant le
# pilote, mettre 34.6703 / 3.2630 (Djelfa) : sinon un rayon de 5 km autour
# d'Alger rend la liste VIDE pour tout client qui n'a pas enregistré son point.
CLIENT_DEFAULT_LATITUDE=36.7538
CLIENT_DEFAULT_LONGITUDE=3.0588

# Rayon de recherche par défaut (km) et plafond accepté par GET /promo.
# Le plafond n'est pas un confort : le rayon dérive une bbox sur une route
# publique et non authentifiée — sans borne, c'est un parcours complet de la
# table à volonté (règle #34, second temps).
#
# ⚠️ **Le plafond est passé de 50 à 5 km le 2026-08-14, décision produit.**
# echango Promo sert des promos de proximité, pas des annonces nationales :
# depuis Alger, chercher ramenait des résultats de Djelfa à 245 km. L'app
# plafonne déjà le cadrage qu'elle déduit du zoom, mais une borne qui ne vit que
# dans le client n'est pas une frontière — un appel direct à l'API la contourne.
#
# ⚠️ **Ce fichier a failli rester à 50.** Il est à la RACINE du dépôt, pas sous
# `apps/backend/` : en le cherchant au mauvais endroit le jour du changement,
# j'ai conclu qu'il n'existait pas et n'ai touché que les deux autres. La
# production aurait donc annoncé un plafond que le pilote n'applique plus —
# exactement la divergence que la règle 36 existe pour empêcher.
CLIENT_DEFAULT_RADIUS_KM=5
CLIENT_MAX_RADIUS_KM=5

# Commerçants renvoyés au maximum pour une zone de carte. Volontairement NON
# servi à l'app : le client reçoit `truncated: true` et en déduit le reste,
# ce qui permet de changer ce nombre sans toucher au banc (règle #32).
MAX_MAP_COMMERCANTS=300

# App Links / Universal Links + fiches store — tout vide tant que l'app
# n'est pas publiée (voir docs/DEPLOIEMENT_STORES.md).
PLAY_STORE_URL=
APP_STORE_URL=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINT=
IOS_TEAM_ID=
IOS_BUNDLE_ID=

# ── Modération ──────────────────────────────────────────────────────────────
#
# Nombre d'appareils DISTINCTS qui doivent avoir signalé une promo pour qu'elle
# entre en file de modération (specs §5.4). Défaut : 3.
#
# ⚠️ **Minimum imposé : 2.** Le seuil avait été abaissé à 1 le 2026-07-12 pour
# une phase de test : un seul signalement suffisait alors à masquer la promo
# d'un concurrent, `X-Device-Id` n'étant jamais vérifié côté serveur et donc
# trivialement rejouable. Une valeur inférieure est refusée et journalisée, le
# défaut s'applique.
#
# ⚠️ Le seuil est évalué à la LECTURE : l'abaisser fait entrer en file,
# rétroactivement, toutes les promos qui atteignent déjà la nouvelle valeur.
MODERATION_REPORT_THRESHOLD=3
