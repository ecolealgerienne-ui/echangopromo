<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP en clair vers la machine de développement uniquement — voir
         `res/xml/network_security_config.xml` pour le détail et la raison.

         Déclaré ici, dans le manifeste de DEBUG, et pas dans `src/main/` :
         ainsi la configuration n'entre pas dans un build de release, où la
         production doit rester en HTTPS strict. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="MissingApplicationIcon" />
</manifest>
